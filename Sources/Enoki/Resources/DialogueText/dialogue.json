{
  "schema_version": 1,
  "speakers": [
    {
      "id": "shiori",
      "displayName": "栞"
    }
  ],
  "dialogues": [
    {
      "id": "work_001",
      "category": "work",
      "cooldown": 3600,
      "lines": [
        {
          "speaker": "shiori",
          "text": "そろそろ、続きに戻りましょうか"
        }
      ]
    },
    {
      "id": "work_002",
      "category": "work",
      "cooldown": 4200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "区切りのよいところまで進めましょう"
        }
      ]
    },
    {
      "id": "work_003",
      "category": "work",
      "cooldown": 3600,
      "lines": [
        {
          "speaker": "shiori",
          "text": "手が止まっていますね"
        },
        {
          "speaker": "shiori",
          "text": "次の一歩だけ決めれば大丈夫です"
        }
      ]
    },
    {
      "id": "work_004",
      "category": "work",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "焦らなくていいですよ。ゆっくり戻りましょう"
        }
      ]
    },
    {
      "id": "work_005",
      "category": "work",
      "cooldown": 4200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "今やることは、ひとつだけで足ります"
        }
      ]
    },
    {
      "id": "water_001",
      "category": "water",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "お水、飲みましたか"
        }
      ]
    },
    {
      "id": "water_002",
      "category": "water",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "喉が渇く前に、一口どうぞ"
        }
      ]
    },
    {
      "id": "water_003",
      "category": "water",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "カップが空になっていませんか"
        }
      ]
    },
    {
      "id": "water_004",
      "category": "water",
      "cooldown": 9000,
      "lines": [
        {
          "speaker": "shiori",
          "text": "水分補給も仕事のうちです"
        }
      ]
    },
    {
      "id": "water_005",
      "category": "water",
      "cooldown": 9000,
      "lines": [
        {
          "speaker": "shiori",
          "text": "飲みものを、手の届くところに置いておきましょう"
        }
      ]
    },
    {
      "id": "break_001",
      "category": "break",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "少し休みましょう。画面から目を離して"
        }
      ]
    },
    {
      "id": "break_002",
      "category": "break",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "肩、こわばっていませんか"
        }
      ]
    },
    {
      "id": "break_003",
      "category": "break",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "立ち上がって、伸びをしてみてください"
        }
      ]
    },
    {
      "id": "break_004",
      "category": "break",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "5 分だけ、何もしない時間を取りましょう"
        }
      ]
    },
    {
      "id": "break_005",
      "category": "break",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "休むのも、続けるためです"
        }
      ]
    },
    {
      "id": "lunch_001",
      "category": "lunch",
      "cooldown": 10800,
      "lines": [
        {
          "speaker": "shiori",
          "text": "お昼の時間ですね。何か食べましょう"
        }
      ]
    },
    {
      "id": "lunch_002",
      "category": "lunch",
      "cooldown": 10800,
      "lines": [
        {
          "speaker": "shiori",
          "text": "そろそろ、お腹がすくころです"
        }
      ]
    },
    {
      "id": "lunch_003",
      "category": "lunch",
      "cooldown": 10800,
      "lines": [
        {
          "speaker": "shiori",
          "text": "お昼がまだなら、先に済ませてしまいましょう"
        }
      ]
    },
    {
      "id": "lunch_004",
      "category": "lunch",
      "cooldown": 10800,
      "lines": [
        {
          "speaker": "shiori",
          "text": "食べてからのほうが、きっとはかどります"
        }
      ]
    },
    {
      "id": "lunch_005",
      "category": "lunch",
      "cooldown": 10800,
      "lines": [
        {
          "speaker": "shiori",
          "text": "今日のお昼は、もう決めましたか"
        }
      ]
    },
    {
      "id": "encouragement_001",
      "category": "encouragement",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "ここまで、よく進みましたね"
        }
      ]
    },
    {
      "id": "encouragement_002",
      "category": "encouragement",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "見ていますよ。大丈夫です"
        }
      ]
    },
    {
      "id": "encouragement_003",
      "category": "encouragement",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "うまくいかない日もあります"
        },
        {
          "speaker": "shiori",
          "text": "それでも、座っているだけで十分です"
        }
      ]
    },
    {
      "id": "encouragement_004",
      "category": "encouragement",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "あと少しだけ、一緒に頑張りましょう"
        }
      ]
    },
    {
      "id": "encouragement_005",
      "category": "encouragement",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "疲れているのに、よく続けていますね"
        }
      ]
    },
    {
      "id": "ambient_001",
      "category": "ambient",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "……今日は、静かですね"
        }
      ]
    },
    {
      "id": "ambient_002",
      "category": "ambient",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "窓の外が、少し明るくなってきました"
        }
      ]
    },
    {
      "id": "ambient_003",
      "category": "ambient",
      "cooldown": 5400,
      "lines": [
        {
          "speaker": "shiori",
          "text": "ページをめくる音だけがしています"
        }
      ]
    },
    {
      "id": "ambient_004",
      "category": "ambient",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "ここにいますから、気にせずどうぞ"
        }
      ]
    },
    {
      "id": "ambient_005",
      "category": "ambient",
      "cooldown": 7200,
      "lines": [
        {
          "speaker": "shiori",
          "text": "いい時間ですね"
        }
      ]
    }
  ]
}
